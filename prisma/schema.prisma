// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}


model Organisateur {
  id_organisateur Int          @id @default(autoincrement())
  nom             String
  prenom          String
  email           String       @unique
  password        String       @unique
  nom_evenement   String
  date_evenement  DateTime
  lieu            String
  Participants    Participant[]
}

model Participant {
  id_participant  Int          @id @default(autoincrement())
  nom             String
  prenom          String
  email           String       @unique
  id_organisateur Int
  Organisateur    Organisateur @relation(fields: [id_organisateur], references: [id_organisateur])
}
